# Red Hat AI MaaS (Models-as-a-Service) -- LIVE endpoint config (optional).
#
# Copy to `.env` (which is gitignored) and fill in. The harness reads these at
# runtime; nothing here is ever committed. With no .env, every "live" path
# degrades to the deterministic agent / ./specs fixtures, so the demo still runs.
#
#   cp .env.example .env   &&   $EDITOR .env
#
# Provision a DEDICATED demo key the morning of the talk: one small model, a low
# rate limit, a spend cap, and an expiry -- then revoke it right after. Treat
# this file as a secret once filled; never paste the key on a shared screen.

# OpenAI-compatible base URL. INCLUDE the /v1 suffix.
MAAS_ENDPOINT=https://my-model.apps.<cluster-domain>/v1

# The served model name (as registered in MaaS / vLLM).
MAAS_MODEL=llama-3-3-70b-instruct

# The API key (3scale application key, or serving token).
MAAS_API_KEY=

# Optional: how the key is sent. Default is the standard bearer header.
# Set to a custom header name (e.g. api-key) if your 3scale plan expects that.
# MAAS_AUTH_HEADER=Authorization
